# Скопируйте этот файл в .env и подставьте значения из Supabase:
#   Project Settings → Data API  → Project URL
#   Project Settings → API Keys  → Publishable key (публичный, аналог старого anon)
VITE_SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ВАШ_ПУБЛИЧНЫЙ_КЛЮЧ

# ВАЖНО: Secret keys (аналог service_role) сюда НЕ добавлять —
# они не должны попадать во фронтенд и в репозиторий.
# В старых проектах вместо publishable может быть anon-ключ (JWT) — он тоже подходит.
